; =============================
; ルビ辞書
; 単語を追加したらここに登録する
; =============================

; キャラクター名
[arb_auto ruby="春子" text="はるこ"]
[arb_auto ruby="蒼汰" text="そうた"]

; 世界観・固有名詞
[arb_auto ruby="魔法" text="まほう"]
[arb_auto ruby="召喚陣" text="しょうかんじん"]
[arb_auto ruby="召喚" text="しょうかん"]
[arb_auto ruby="世界" text="せかい"]
[arb_auto ruby="結界" text="けっかい"]

; 個別ルビ（各文字に対応するルビを"|"区切りで指定）
[arb_auto ruby="自動人形" split="オ|ート|マ|タ"]
[arb_auto ruby="仕立て屋" split="テ|イ|ラ|ー"]

[return]
